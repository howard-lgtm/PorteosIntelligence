{
  "manifest_version": 3,
  "name": "Porteos Importer",
  "version": "3.0.0",
  "description": "Send property listings from 12 major real estate sites (USA, Portugal, Spain, Sweden) into Porteos Intelligence.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:9000/*",

    "*://www.zillow.com/*",
    "*://www.realtor.com/*",
    "*://www.redfin.com/*",
    "*://www.trulia.com/*",

    "*://www.idealista.pt/*",
    "*://casa.sapo.pt/*",
    "*://www.remax.pt/*",
    "*://remax.pt/*",
    "*://www.imovirtual.com/*",

    "*://www.idealista.com/*",
    "*://www.fotocasa.es/*",

    "*://www.hemnet.se/*",
    "*://www.booli.se/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.zillow.com/*",
        "*://www.realtor.com/*",
        "*://www.redfin.com/*",
        "*://www.trulia.com/*",

        "*://www.idealista.pt/*",
        "*://casa.sapo.pt/*",
        "*://www.remax.pt/*",
        "*://remax.pt/*",
        "*://www.imovirtual.com/*",

        "*://www.idealista.com/*",
        "*://www.fotocasa.es/*",

        "*://www.hemnet.se/*",
        "*://www.booli.se/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Porteos Importer",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  }
}
