{
  "$schema": "porteos-figma-screens-v1",
  "description": "Screen inventory for Figma page structure. Frame sizes use 1200×800 default window.",
  "figmaPageStructure": [
    "00 — Cover & Tokens",
    "01 — Components",
    "02 — Shell & Navigation",
    "03 — Dashboards",
    "04 — Inspector & Overlays",
    "05 — Sheets & Modals",
    "06 — Admin & Extension"
  ],
  "screens": [
    {
      "id": "shell-default",
      "name": "App Shell — Deal Selected",
      "page": "02 — Shell & Navigation",
      "priority": "P0",
      "frame": { "width": 1200, "height": 800 },
      "components": ["app-shell", "real-estate-dashboard", "inspector-pane"],
      "sampleContent": { "deal": "Lisbon Office Block A", "profile": "real_estate" }
    },
    {
      "id": "shell-empty",
      "name": "App Shell — No Deal",
      "page": "02 — Shell & Navigation",
      "priority": "P1",
      "frame": { "width": 1200, "height": 800 },
      "components": ["app-shell", "empty-state"],
      "cta": "[ ./LOAD_SAMPLE_DEAL ]"
    },
    {
      "id": "shell-cmd-center",
      "name": "Command Center",
      "page": "03 — Dashboards",
      "priority": "P1",
      "profile": "cmd_center",
      "modules": ["PORTFOLIO_SUMMARY", "PROFILE_HEALTH", "PROFILE_DISTRIBUTION", "RECENT_ACTIVITY", "SYSTEM_STATUS"]
    },
    {
      "id": "dashboard-real-estate",
      "name": "Real Estate Dashboard",
      "page": "03 — Dashboards",
      "priority": "P0",
      "profile": "real_estate",
      "accent": "#C25E30",
      "modules": [
        "PORTEOS_SCORE",
        "01 // CORE_FINANCIALS_REVENUE",
        "02 // EXPENSE_AUDIT_OPEX",
        "03 // PROFITABILITY_TELEMETRY",
        "04 // LEVERAGE_ENGINE",
        "05 // RETURN_METRICS",
        "06 // SENSITIVITY",
        "VALIDATION_LOG",
        "MARKET_TRENDS"
      ],
      "metricCount": 35,
      "note": "Stress-test screen — redesign this first"
    },
    {
      "id": "dashboard-hospitality",
      "name": "Hospitality Dashboard",
      "page": "03 — Dashboards",
      "priority": "P0",
      "profile": "hospitality",
      "accent": "#14B8A6",
      "modules": ["PORTEOS_SCORE", "01 // OPERATIONAL_STATS", "02 // PROFITABILITY_MATRIX", "03 // DISTRIBUTION_LOG", "SENSITIVITY", "VALIDATION_LOG", "MARKET_TRENDS"]
    },
    {
      "id": "dashboard-design",
      "name": "Design Dashboard",
      "page": "03 — Dashboards",
      "priority": "P0",
      "profile": "design",
      "accent": "#A855F7",
      "modules": ["PORTEOS_SCORE", "01 // SPACE_EFFICIENCY", "02 // WELLNESS_METRICS", "03 // BIOPHILIC_ELEMENTS", "04 // ADAPTABILITY", "SENSITIVITY", "VALIDATION_LOG", "MARKET_TRENDS"]
    },
    {
      "id": "dashboard-circular",
      "name": "Circular Economy Dashboard",
      "page": "03 — Dashboards",
      "priority": "P0",
      "profile": "circular",
      "accent": "#3B82F6",
      "modules": ["PORTEOS_SCORE", "01 // MATERIAL_FLOW_LOG", "02 // CARBON_LIFECYCLE_SUMMARY", "03 // RESOURCE_EFFICIENCY", "SENSITIVITY", "VALIDATION_LOG", "MARKET_TRENDS"]
    },
    {
      "id": "comparison-view",
      "name": "Comparison View",
      "page": "03 — Dashboards",
      "priority": "P1",
      "components": ["comparison-table"],
      "minDeals": 2
    },
    {
      "id": "inspector-weights",
      "name": "Inspector — Weights Tab",
      "page": "04 — Inspector & Overlays",
      "priority": "P0",
      "tab": "WEIGHTS",
      "sliders": ["Real Estate", "Hospitality", "Design", "Circular"]
    },
    {
      "id": "inspector-ai-idle",
      "name": "Inspector — AI Vibe Idle",
      "page": "04 — Inspector & Overlays",
      "priority": "P2",
      "tab": "AI VIBE",
      "state": "idle"
    },
    {
      "id": "inspector-ai-result",
      "name": "Inspector — AI Vibe Result",
      "page": "04 — Inspector & Overlays",
      "priority": "P2",
      "tab": "AI VIBE",
      "state": "result"
    },
    {
      "id": "command-palette",
      "name": "Command Palette",
      "page": "04 — Inspector & Overlays",
      "priority": "P2",
      "overlay": true,
      "shortcut": "⌘K"
    },
    {
      "id": "shortcuts-legend",
      "name": "Keyboard Shortcuts",
      "page": "04 — Inspector & Overlays",
      "priority": "P2",
      "overlay": true,
      "shortcut": "⌘/"
    },
    {
      "id": "ingestion-toast",
      "name": "Ingestion Toast",
      "page": "04 — Inspector & Overlays",
      "priority": "P2",
      "overlay": true
    },
    {
      "id": "sheet-template-picker",
      "name": "Template Picker",
      "page": "05 — Sheets & Modals",
      "priority": "P1",
      "width": 640,
      "categories": ["ALL", "REAL ESTATE", "HOSPITALITY", "MIXED-USE", "DESIGN", "CIRCULAR"],
      "templateCount": 12
    },
    {
      "id": "sheet-full-edit-base",
      "name": "Full Deal Editor — Base",
      "page": "05 — Sheets & Modals",
      "priority": "P1",
      "tabs": ["BASE", "REAL_ESTATE", "HOSPITALITY", "DESIGN", "CIRCULAR"],
      "activeTab": "BASE"
    },
    {
      "id": "sheet-full-edit-re",
      "name": "Full Deal Editor — Real Estate",
      "page": "05 — Sheets & Modals",
      "priority": "P1",
      "activeTab": "REAL_ESTATE",
      "fieldCount": 20
    },
    {
      "id": "sheet-quick-add",
      "name": "Quick Add",
      "page": "05 — Sheets & Modals",
      "priority": "P1",
      "elements": ["nl-input", "parse-preview", "confidence-pill"]
    },
    {
      "id": "sheet-import",
      "name": "Import Deals",
      "page": "05 — Sheets & Modals",
      "priority": "P1",
      "elements": ["file-picker", "preview-table", "column-mapping"]
    },
    {
      "id": "sheet-export",
      "name": "Bulk Export",
      "page": "05 — Sheets & Modals",
      "priority": "P1",
      "options": {
        "format": ["CSV", "JSON"],
        "depth": ["BASE FIELDS", "+FINANCIALS", "ALL METRICS"],
        "scope": ["ALL DEALS", "PIPELINE ONLY", "VIABLE ONLY", "ACQUIRED ONLY"]
      }
    },
    {
      "id": "sheet-pdf",
      "name": "PDF Report Config",
      "page": "05 — Sheets & Modals",
      "priority": "P2",
      "toggles": ["AI analysis", "Validation log", "Saved scenarios", "B&W mode"]
    },
    {
      "id": "sheet-triage",
      "name": "Batch Triage",
      "page": "05 — Sheets & Modals",
      "priority": "P2",
      "elements": ["stats-header", "card-grid", "approve-reject-bar"]
    },
    {
      "id": "sheet-settings",
      "name": "Settings",
      "page": "06 — Admin & Extension",
      "priority": "P2",
      "tabs": ["EMAIL_INGESTION", "INGESTION_SERVER", "GENERAL"]
    },
    {
      "id": "sheet-email-setup",
      "name": "Email Setup",
      "page": "06 — Admin & Extension",
      "priority": "P2",
      "presets": ["Gmail", "Outlook", "iCloud", "Yahoo", "Custom"]
    },
    {
      "id": "sheet-server-config",
      "name": "Server Config",
      "page": "06 — Admin & Extension",
      "priority": "P2",
      "elements": ["port-input", "start-stop-restart", "endpoint-docs", "request-log"]
    },
    {
      "id": "detached-nav",
      "name": "Detached Navigation Pane",
      "page": "02 — Shell & Navigation",
      "priority": "P3",
      "floating": true
    },
    {
      "id": "extension-button",
      "name": "Browser Extension Button",
      "page": "06 — Admin & Extension",
      "priority": "P3",
      "sites": ["Idealista", "Zillow", "Hemnet"],
      "states": ["default", "sending", "sent", "error"]
    }
  ],
  "redesignPhases": [
    { "phase": 0, "name": "Tokens + Components", "screens": [] },
    { "phase": 1, "name": "Shell + Nav", "screens": ["shell-default", "shell-empty", "detached-nav"] },
    { "phase": 2, "name": "Dashboards", "screens": ["dashboard-real-estate", "dashboard-hospitality", "dashboard-design", "dashboard-circular", "shell-cmd-center", "comparison-view"] },
    { "phase": 3, "name": "Inspector", "screens": ["inspector-weights", "inspector-ai-idle", "inspector-ai-result"] },
    { "phase": 4, "name": "Core Sheets", "screens": ["sheet-template-picker", "sheet-full-edit-base", "sheet-quick-add", "sheet-import", "sheet-export"] },
    { "phase": 5, "name": "Overlays + Admin", "screens": ["command-palette", "shortcuts-legend", "ingestion-toast", "sheet-pdf", "sheet-triage", "sheet-settings", "sheet-email-setup", "sheet-server-config"] },
    { "phase": 6, "name": "Extension", "screens": ["extension-button"] }
  ]
}
