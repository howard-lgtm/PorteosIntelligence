  "cursorInstructions": {
    "onStart": [
      "Read this entire file before taking any action",
      "Read Design-system/Figma/porteos.tokens.json and porteos.components.json",
      "Ask user to resolve designDecisions if not already specified — use defaults if user says proceed",
      "Execute phases in order; mark tasks complete only when acceptanceCriteria met",
      "Reference PorteosIntelligence/Views/ for layout fidelity when building frames",
      "Do not invent new features; this is look-and-feel only"
    ],
    "onPhaseComplete": [
      "Report which tasks completed with acceptance criteria status",
      "List any blockers or unresolved designDecisions",
      "Confirm next phase dependencies satisfied before proceeding"
    ],
    "onComplete": [
      "Run validationChecklist and report pass/fail per item",
      "Summarize final designDecisions chosen",
      "Provide Figma file status and recommended next steps for SwiftUI implementation"
    ],
    "figmaApiNote": "Cursor cannot directly edit Figma files without Figma MCP or API integration. If no Figma integration is available, output detailed frame specs per task for manual build, or use Figma REST API if token provided."
  },
