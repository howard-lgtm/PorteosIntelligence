            "button-secondary",
            "status-pill",
            "deal-row",
            "profile-nav-link",
            "terminal-block",
            "metric-grid-cell",
            "metric-with-trend",
            "terminal-input",
            "tab-bar"
          ],
          "acceptanceCriteria": [
            "Each component uses Figma variables not hardcoded hex",
            "Primary button has palette variants: rust, teal, purple, blue, green, red, amber, muted",
            "Status pill has 5 status variants",
            "Deal row has selected and compare-selected variants",
            "Metric grid cell has neutral, optimal, warning, danger variants",
            "All components have 0 corner radius"
