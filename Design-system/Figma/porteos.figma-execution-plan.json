{
  "$schema": "porteos-cursor-figma-execution-v1",
  "version": "1.0.0",
  "title": "Porteos Intelligence — Figma UI Redesign Execution Plan",
  "description": "Machine-readable plan for Cursor to execute the Porteos Intelligence look-and-feel overhaul in Figma. Read this file first, then follow phases in order. Do not skip acceptance criteria.",
  "product": {
    "name": "Porteos Intelligence",
    "version": "PORTEOS_TERMINAL_v1.0.4",
    "platform": "macOS SwiftUI",
    "redesignScope": "look-and-feel only — preserve all features and information architecture"
  },
  "inputFiles": {
    "tokens": "Design-system/Figma/porteos.tokens.json",
    "tokensW3c": "Design-system/Figma/porteos.tokens.w3c.json",
    "components": "Design-system/Figma/porteos.components.json",
    "screens": "Design-system/Figma/porteos.screens.json",
    "screensCsv": "Design-system/Figma/porteos.screens.csv",
    "readme": "Design-system/Figma/README.md",
    "startupAnimationHandoff": "Design-system/Figma/STARTUP_ANIMATION_HANDOFF.md",
    "displayDensity": "Design-system/Figma/DISPLAY_DENSITY.md",
    "punchlist": "PUNCHLIST.md",
    "designSystemDoc": "PorteosIntelligence/01_TERMINAL_DESIGN_SYSTEM.md",
    "codebaseShell": "PorteosIntelligence/Views/Shell/AppShell.swift"
  },
  "figmaSetup": {
    "plugin": "Tokens Studio for Figma",
    "pluginUrl": "https://tokens.studio/",
    "importFile": "Design-system/Figma/porteos.tokens.json",
    "theme": "porteos-dark",
    "fonts": [
      { "family": "JetBrains Mono", "weights": [400, 500, 700], "required": true },
      { "family": "Inter", "weights": [400, 700], "required": false, "note": "Spec only — long AI prose" }
    ],
    "defaultFrame": { "width": 1200, "height": 800, "unit": "px" },
    "gridBase": 8,
    "cornerRadius": 0
  },
  "designDecisions": {
    "instructions": "Resolve these before Phase 2. If user has not specified, use defaults below and document in Figma cover page.",
    "items": [
      {
        "id": "re-accent",
        "question": "Real Estate profile accent color?",
        "options": [
          { "id": "rust", "value": "#C25E30", "label": "Rust (live app)" },
          { "id": "gold", "value": "#D4AF37", "label": "Gold (design doc v3.0)" }
        ],
        "default": "rust"
      },
      {
        "id": "aesthetic-direction",
        "question": "Overall aesthetic direction?",
        "options": [
          { "id": "terminal", "label": "Keep full CLI terminal aesthetic" },
          { "id": "hybrid", "label": "Terminal data + cleaner institutional chrome" },
          { "id": "product", "label": "Move toward institutional SaaS product" }
        ],
        "default": "hybrid"
      },
      {
        "id": "button-format",
        "question": "Button copy format?",
        "options": [
          { "id": "cli", "label": "Keep [ ACTION ] and ./script syntax" },
          { "id": "standard", "label": "Standard button labels (Edit Deal, Import…)" }
        ],
        "default": "cli"
      },
      {
        "id": "cli-headers",
        "question": "CLI command headers on every module?",
        "options": [
          { "id": "keep", "label": "Keep porteos@system ~ % headers" },
          { "id": "simplify", "label": "Simplify to module titles only" },
          { "id": "remove", "label": "Remove CLI headers" }
        ],
        "default": "keep"
      },
      {
        "id": "density",
        "question": "Information density?",
        "options": [
          { "id": "dense", "label": "Keep terminal-dense (28px rows)" },
          { "id": "balanced", "label": "Slightly more whitespace" },
          { "id": "spacious", "label": "Generous spacing for readability" }
        ],
        "default": "dense"
      },
      {
        "id": "nav-width",
        "question": "Navigation pane width?",
        "options": [
          { "id": "260", "value": 260, "label": "260px (live code)" },
          { "id": "220", "value": 220, "label": "220px (design doc)" }
        ],
        "default": "260"
      },
      {
        "id": "inspector-width",
        "question": "Inspector pane width?",
        "options": [
          { "id": "280", "value": 280, "label": "280px (live code)" },
          { "id": "320", "value": 320, "label": "320px (design doc)" }
        ],
        "default": "280"
      }
    ]
  },
  "constraints": {
    "mustPreserve": [
      "3-pane layout: navigation + center analysis + inspector",
      "5 profiles: Command Center, Real Estate, Hospitality, Design, Circular Economy",
      "Porteos Score with letter grade A–F",
      "Deal pipeline statuses: pipeline, review, viable, rejected, acquired",
      "All dashboard modules and metrics listed in porteos.screens.json",
      "Inspector tabs: WEIGHTS and AI VIBE",
      "All 12 sheet flows: template picker, quick add, import, export, full edit, PDF, triage, settings, email, server",
      "Compare mode, batch triage, advanced filters, command palette",
      "Threshold-only semantic coloring (green/amber/red) — never color normal metrics by identity"
    ],
    "mustNotBreak": [
      "State vs identity color rule",
      "Zero rounded corners unless user explicitly chooses otherwise in designDecisions",
      "JetBrains Mono for all numeric values",
      "Import-first workflow prominence (import before manual entry in nav hierarchy)"
    ],
    "canOmitOrMerge": [
      "Legacy EditDealSheet, NewDealSheet, QuickAddDealSheet",
      "Unwired header bell/settings icons",
      "Display-only global command bar input",
      "tags and isFavorite (no current UI)"
    ]
  },
  "startupSplash": {
    "status": "in_progress",
    "figmaHandoff": "Design-system/Figma/STARTUP_ANIMATION_HANDOFF.md",
    "assetPath": "PorteosIntelligence/Resources/Splash/",
    "naming": "porteos_splash_{###}.png",
    "appFiles": [
      "PorteosIntelligence/Views/Splash/SplashView.swift",
      "PorteosIntelligence/Views/Splash/RootView.swift",
      "PorteosIntelligence/PorteosIntelligenceApp.swift"
    ],
    "blockedBy": "Copy PNG sequence from CascadeProjects into Resources/Splash/",
    "configFields": ["frameCount", "fps", "minimumDuration", "canvasSize"]
  },
  "figmaPages": [
    { "order": 0, "name": "00 — Cover & Tokens", "purpose": "Project brief, open decisions, swatches, type scale" },
    { "order": 1, "name": "01 — Components", "purpose": "Component library with variants" },
    { "order": 2, "name": "02 — Shell & Navigation", "purpose": "App shell and nav pane" },
    { "order": 3, "name": "03 — Dashboards", "purpose": "All 5 profile views + comparison" },
    { "order": 4, "name": "04 — Inspector & Overlays", "purpose": "Inspector, command palette, toasts" },
    { "order": 5, "name": "05 — Sheets & Modals", "purpose": "All modal flows" },
    { "order": 6, "name": "06 — Admin & Extension", "purpose": "Settings, email, server, browser extension" }
  ],
  "phases": [
    {
      "id": "phase-0",
      "name": "Setup & Token Import",
      "order": 0,
      "status": "cursor-complete",
      "cursorNote": "Tokens reconciled to V2.06. Figma import + pages + cover require manual steps — see PHASE-0-FIGMA-CHECKLIST.md",
      "tasks": [
        {
          "id": "0.1",
          "action": "IMPORT_TOKENS",
          "description": "Import porteos.tokens.json into Figma via Tokens Studio",
          "input": "Design-system/Figma/porteos.tokens.json",
          "output": "Figma variables: Porteos/color, Porteos/typography, Porteos/spacing",
          "acceptanceCriteria": [
            "Porteos Dark theme applied",
            "All shell colors exist as variables",
            "All 6 profile accent colors exist",
            "All 5 status colors exist",
            "Typography styles synced for metric-label, metric-value, score-hero, button-primary"
          ]
        },
        {
          "id": "0.2",
          "action": "CREATE_PAGES",
          "description": "Create 7 Figma pages per figmaPages array",
          "output": "7 empty pages with correct names",
          "acceptanceCriteria": ["All page names match figmaPages exactly"]
        },
        {
          "id": "0.3",
          "action": "CREATE_COVER",
          "description": "Build cover frame on page 00 with project brief and resolved designDecisions",
          "page": "00 — Cover & Tokens",
          "content": [
            "Product name and version",
            "Redesign scope statement",
            "Resolved designDecisions table",
            "Color swatch grid (shell, text, semantic, profile, status)",
            "Type scale specimen (8pt through 48pt)",
            "Spacing scale (4, 8, 12, 16, 24, 32)"
