          "acceptanceCriteria": ["Cover frame exists", "All colors visually swatched", "Decisions documented"]
        }
      ]
    },
    {
      "id": "phase-1",
      "name": "Component Library",
      "order": 1,
      "status": "pending",
      "dependsOn": ["phase-0"],
