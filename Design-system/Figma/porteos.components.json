{
  "$schema": "porteos-figma-components-v1",
  "description": "Component library spec for Figma. Build each as a component with variants. Dimensions in px (macOS points).",
  "designPrinciples": [
    "Zero rounded corners — borderRadius 0 everywhere",
    "State vs identity — semantic colors only for threshold breaches",
    "Profile accent colors only for headers, active tabs, indicator fills",
    "JetBrains Mono for 95%+ of UI",
    "28pt row rhythm for interactive elements"
  ],
  "components": [
    {
      "id": "app-shell",
      "name": "App Shell",
      "priority": "P0",
      "layout": {
        "structure": "Header (40) + HStack[Nav 260 | Divider 1 | Center flex | Divider 1 | Inspector 280] + CommandBar (32)",
        "minWidth": 1200,
        "minHeight": 800,
        "background": "{color.shell.bg}"
      },
      "children": ["top-header-bar", "navigation-pane", "center-pane", "inspector-pane", "global-command-bar", "pane-divider"]
    },
    {
      "id": "top-header-bar",
      "name": "Top Header Bar",
      "priority": "P0",
      "height": 40,
      "elements": [
        { "role": "wordmark", "text": "PORTEOS_TERMINAL", "typography": "navTitle" },
        { "role": "breadcrumb", "text": "profile --path --asset=\"Deal Name\"", "typography": "caption", "color": "text.tertiary" },
        { "role": "server-led", "component": "server-status-indicator" },
        { "role": "icon", "name": "bell", "wired": false },
        { "role": "icon", "name": "settings", "wired": false }
      ]
    },
    {
      "id": "global-command-bar",
      "name": "Global Command Bar",
      "priority": "P0",
      "height": 32,
      "background": "{color.shell.surface}",
      "elements": [
        { "role": "prompt", "text": "porteos@system ~ %", "color": "text.tertiary" },
        { "role": "input", "placeholder": "", "flex": true },
        { "role": "status", "text": "UTF-8  LN: 0", "color": "text.tertiary" }
      ]
    },
    {
      "id": "navigation-pane",
      "name": "Navigation Pane",
      "priority": "P0",
      "width": 260,
      "background": "{color.shell.surface}",
      "sections": [
        { "id": "header", "content": ["PORTEOS@SYSTEM", "STATUS: ENCRYPTED"] },
        { "id": "profile-nav", "items": ["/cmd_center", "/real_estate", "/hospitality", "/design", "/circular"] },
        { "id": "deals-header", "actions": ["[ FILTER ]", "[ CMP ]", "[ TRIAGE ]"] },
        { "id": "status-tabs", "items": ["ALL", "PIPELINE", "REVIEW", "VIABLE", "REJECTED"] },
        { "id": "search", "placeholder": "Search deals…" },
        { "id": "filter-panel", "component": "advanced-filter-panel", "collapsible": true },
        { "id": "deal-list", "itemComponent": "deal-row" },
        { "id": "compare-bar", "visible": "compareMode", "content": "[ LAUNCH_COMPARE (n) ]" },
        { "id": "bulk-actions", "items": ["[ ./BULK_EXPORT ]", "[ ./BULK_DELETE ]"] },
        { "id": "footer", "items": ["[ ./NEW_DEAL ]", "[ ./IMPORT_DEALS ]"] }
      ]
    },
    {
      "id": "deal-row",
      "name": "Deal Row",
      "priority": "P0",
      "height": 28,
      "variants": {
        "state": ["default", "selected", "compare-selected"],
        "status": ["pipeline", "review", "viable", "rejected", "acquired"]
      },
      "anatomy": [
        { "part": "selection-pip", "width": 4, "visible": "selected" },
        { "part": "checkbox", "visible": "compareMode" },
        { "part": "name", "typography": "navLink", "truncate": true },
        { "part": "status-pill", "height": 16, "typography": "micro" }
      ],
      "interactions": ["click:select", "context-menu:edit-deal"]
    },
    {
      "id": "profile-nav-link",
      "name": "Profile Nav Link",
      "priority": "P0",
      "height": 24,
      "variants": { "state": ["inactive", "active"] },
      "activeStyle": { "fontWeight": "bold", "color": "text.primary", "background": "shell.elevated" },
      "inactiveStyle": { "color": "text.tertiary" },
      "format": "/profile_path"
    },
    {
      "id": "terminal-block",
      "name": "Terminal Block",
      "priority": "P0",
      "anatomy": [
        { "part": "header", "height": 24, "format": "porteos@system ~ % {command}", "paddingX": 12 },
        { "part": "divider", "height": 1, "color": "shell.border" },
        { "part": "content", "padding": 12, "slot": true }
      ],
      "commandExamples": [
        "01 // CORE_FINANCIALS_REVENUE",
        "02 // EXPENSE_AUDIT_OPEX",
        "01 // OPERATIONAL_STATS",
        "01 // PORTFOLIO_SUMMARY"
      ]
    },
    {
      "id": "metric-grid-cell",
      "name": "Metric Grid Cell",
      "priority": "P0",
      "variants": { "state": ["neutral", "optimal", "warning", "danger"] },
      "anatomy": [
        { "part": "label", "typography": "metricLabel", "color": "text.tertiary", "uppercase": true, "maxLines": 2 },
        { "part": "value", "typography": "metricValue", "monospacedDigits": true }
      ],
      "stateColors": {
        "neutral": "text.valueBright",
        "optimal": "semantic.success",
        "warning": "semantic.warning",
        "danger": "semantic.danger"
      },
      "paddingY": 6,
      "usedInGrid": { "minColumn": 160, "maxColumn": 250, "gap": 16, "rowGap": 12 }
    },
    {
      "id": "metric-with-trend",
      "name": "Metric With Trend",
      "priority": "P0",
      "extends": "metric-grid-cell",
      "extra": [{ "part": "sparkline", "height": 24, "width": 64 }]
    },
    {
      "id": "terminal-metric-row",
      "name": "Terminal Metric Row",
      "priority": "P1",
      "height": 28,
      "variants": { "state": ["neutral", "optimal", "warning", "danger"] },
      "anatomy": [
        { "part": "danger-border", "width": 2, "visible": "danger", "color": "semantic.danger" },
        { "part": "label", "align": "left", "typography": "metricLabel" },
        { "part": "value", "align": "right", "typography": "metricValue" }
      ],
      "note": "List layout only — do not use inside grids"
    },
    {
      "id": "button-primary",
      "name": "Button / Primary",
      "priority": "P0",
      "height": 28,
      "format": "[ {TITLE} ]",
      "typography": "buttonPrimary",
      "background": "profile accent (per context)",
      "textColor": "text.onAccent",
      "variants": { "palette": ["rust", "teal", "purple", "blue", "green", "red", "amber", "muted"] }
    },
    {
      "id": "button-secondary",
      "name": "Button / Secondary",
      "priority": "P0",
      "height": 28,
      "format": "./{title}",
      "typography": "buttonSecondary",
      "textColor": "semantic.success",
      "background": "transparent"
    },
    {
      "id": "terminal-input",
      "name": "Terminal Input Field",
      "priority": "P1",
      "height": 28,
      "anatomy": [
        { "part": "label", "typography": "caption", "optional": true },
        { "part": "field", "bg": "shell.bg", "border": "1px shell.border", "focusBorder": "profile accent" },
        { "part": "prefix", "optional": true },
        { "part": "suffix", "optional": true }
      ],
      "typography": "input"
    },
    {
      "id": "porteos-score-block",
      "name": "Porteos Score Block",
      "priority": "P1",
      "background": "shell.surface",
      "border": "1px shell.border",
      "padding": 16,
      "anatomy": [
        { "part": "score", "typography": "scoreHero", "color": "grade-based" },
        { "part": "label", "text": "PORTEOS SCORE", "typography": "caption" },
        { "part": "grade", "typography": "scoreGrade", "color": "grade-based" }
      ]
    },
    {
      "id": "circular-score-ring",
      "name": "Circular Score Ring",
      "priority": "P1",
      "sizes": [120, 180],
      "strokeWidth": 4,
      "trackColor": "shell.border",
      "fillColor": "profile accent",
      "center": { "score": "scoreHero or 24pt", "label": "SCORE 11pt" }
    },
    {
      "id": "status-pill",
      "name": "Status Pill",
      "priority": "P0",
      "height": 16,
      "variants": { "status": ["pipeline", "review", "viable", "rejected", "acquired"] },
      "typography": "micro",
      "uppercase": true
    },
    {
      "id": "inspector-pane",
      "name": "Inspector Pane",
      "priority": "P0",
      "width": 280,
      "sections": [
        { "id": "header", "text": "./INSPECTOR_V2" },
        { "id": "actions", "buttons": ["[ EDIT DEAL DATA ]", "[ PDF ]"] },
        { "id": "history", "buttons": ["[ ↩ ]", "[ ↪ ]"] },
        { "id": "tabs", "items": ["WEIGHTS", "AI VIBE"] },
        { "id": "weights", "sliders": 4, "autoRebalance": true },
        { "id": "ai-vibe", "component": "ai-vibe-panel" }
      ]
    },
    {
      "id": "tab-bar",
      "name": "Tab Bar",
      "priority": "P1",
      "height": 36,
      "activeIndicator": "2px underline, profile accent",
      "typography": "buttonPrimary"
    },
    {
      "id": "system-log-block",
      "name": "System Log Block",
      "priority": "P2",
      "entryFormats": ["[ERR] message", "[WARN] message"],
      "colors": { "ERR": "semantic.danger", "WARN": "semantic.warning" }
    },
    {
      "id": "market-trend-module",
      "name": "Market Trend Module",
      "priority": "P2",
      "elements": ["heat-badge", "metric-sparklines", "import-activity"]
    },
    {
      "id": "sensitivity-block",
      "name": "Sensitivity Block",
      "priority": "P2",
      "variants": ["real-estate", "hospitality", "design", "circular"],
      "elements": ["adjustment-sliders", "base-vs-sim-comparison", "scenario-manager"]
    },
    {
      "id": "ai-vibe-panel",
      "name": "AI Vibe Panel",
      "priority": "P2",
      "states": ["idle", "running", "result"],
      "anatomy": [
        { "part": "grade-badge", "values": "A-F" },
        { "part": "signal-sections", "categories": ["RE", "Hospitality", "Design", "Circular", "Market"] },
        { "part": "sentiment-prefix", "values": ["+", "·", "~", "!"] },
        { "part": "apply-button", "text": "[ APPLY ]" },
        { "part": "stat-summary" }
      ]
    },
    {
      "id": "advanced-filter-panel",
      "name": "Advanced Filter Panel",
      "priority": "P2",
      "sections": ["search", "price-range", "cap-rate-range", "noi-range", "score-range", "profile-toggles", "location"],
      "actions": ["[ APPLY_FILTERS ]", "[ CLEAR_ALL ]"]
    },
    {
      "id": "sheet-chrome",
      "name": "Sheet Chrome",
      "priority": "P1",
      "width": 460,
      "anatomy": [
        { "part": "header", "format": "porteos@system ~ % {sheet_name}", "height": 40 },
        { "part": "divider", "height": 1 },
        { "part": "body", "scrollable": true },
        { "part": "footer-actions", "optional": true }
      ]
    },
    {
      "id": "template-card",
      "name": "Template Card",
      "priority": "P1",
      "variants": { "category": ["realEstate", "hospitality", "mixedUse", "design", "circular"] },
      "anatomy": ["category-badge", "name", "description", "key-metrics (up to 3)"]
    },
    {
      "id": "triage-card",
      "name": "Triage Card",
      "priority": "P2",
      "variants": { "state": ["default", "selected"] },
      "anatomy": ["grade", "score", "price", "area", "heat-badge"]
    },
    {
      "id": "comparison-table",
      "name": "Comparison Table",
      "priority": "P1",
      "columns": "dynamic per deal",
      "rows": ["PURCHASE PRICE", "GPI", "NOI", "CAP RATE", "CFBT", "LTV", "DSCR", "PORTEOS SCORE"],
      "highlighting": ["best", "worst"]
    },
    {
      "id": "command-palette",
      "name": "Command Palette",
      "priority": "P2",
      "width": 560,
      "maxHeight": 400,
      "elements": ["search-input", "result-list", "hint-bar"],
      "resultPrefixes": { "deal": "[D]", "action": "[>]" }
    },
    {
      "id": "ingestion-toast",
      "name": "Ingestion Toast",
      "priority": "P2",
      "width": 320,
      "position": "top-right",
      "elements": ["deal-name", "progress-bar", "dismiss"]
    },
    {
      "id": "server-status-indicator",
      "name": "Server Status LED",
      "priority": "P2",
      "size": 8,
      "variants": { "state": ["offline", "running", "error"] }
    },
    {
      "id": "browser-extension-button",
      "name": "Browser Extension Button",
      "priority": "P3",
      "position": "fixed bottom-right on listing pages",
      "text": "[ SEND TO PORTEOS ]",
      "states": ["default", "sending", "sent", "error"]
    }
  ]
}
